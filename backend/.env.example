# ==============================================================================
# GEO-MINE AI BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Gemini API Key (Used by google-genai SDK for gemini-2.5-flash / gemini-3.7-flash)
# Generate from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Django Security Key
DJANGO_SECRET_KEY=your-django-secret-key-change-in-production

# Server Settings
DEBUG=True
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: PostgreSQL Database (Falls back to SQLite db.sqlite3 if empty)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/geomine_db
